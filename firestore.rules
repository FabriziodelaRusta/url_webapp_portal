rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Configuration publique de la page d'accueil (Portail Gravel & GPX)
    match /portal_config/settings {
      // 1. Lecture publique : Tous les visiteurs peuvent charger la page et voir les icônes
      allow read: if true;
      
      // 2. Écriture réservée à l'administrateur authentifié par email
      allow write: if request.auth != null 
                   && request.auth.token.email == "mezitineraires@gmail.com";
    }
    
    // Règle par défaut pour le reste de la base (verrouillé par précaution)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
